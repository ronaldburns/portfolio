---
import { getCollection } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Img from '../components/Img.astro';
import { SITE_TITLE, SITE_DESCRIPTION, AUTHOR, ROLE, BIO, SOCIALS } from '../consts';

const posts = (await getCollection('projects'))
	.filter((p) => p.data.published !== false)
	.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

// Group by year, newest first.
const byYear = new Map<number, typeof posts>();
for (const post of posts) {
	const year = post.data.date.getFullYear();
	if (!byYear.has(year)) byYear.set(year, []);
	byYear.get(year)!.push(post);
}
const years = [...byYear.keys()].sort((a, b) => b - a);

const jsonLd = {
	'@context': 'https://schema.org',
	'@type': 'Person',
	name: AUTHOR,
	jobTitle: 'Gameplay Programmer',
	worksFor: { '@type': 'Organization', name: 'Mob Entertainment' },
	url: 'https://ronaldburns.dev',
	sameAs: SOCIALS.filter((s) => s.href.startsWith('http')).map((s) => s.href),
};
---

<html lang="en">
	<head>
		<BaseHead title={`${SITE_TITLE} | ${ROLE}`} description={SITE_DESCRIPTION} />
		<script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
	</head>
	<body>
		<Header />
		<main class="max-w-3xl mx-auto px-4">
			<section class="py-16 sm:py-20 border-b border-zinc-800/80">
				<h1 class="font-display text-4xl sm:text-6xl text-zinc-50">{AUTHOR}</h1>
				<p class="text-accent/90 mt-3 text-lg">{ROLE}</p>
				<p class="text-zinc-400 mt-5 max-w-xl leading-relaxed">{BIO}</p>
				<div class="flex flex-wrap gap-x-5 gap-y-2 mt-6 text-sm">
					{
						SOCIALS.map((s) => (
							<a
								href={s.href}
								target={s.href.startsWith('http') ? '_blank' : undefined}
								rel="noopener"
								class="text-zinc-400 hover:text-accent transition-colors"
							>
								{s.label} <span class="text-zinc-600">·</span> {s.handle}
							</a>
						))
					}
				</div>
			</section>

			{
				years.map((year) => (
					<section class="py-10 border-b border-zinc-900 last:border-0">
						<h2 class="font-display text-sm uppercase tracking-widest text-zinc-500 mb-6">{year}</h2>
						<ul class="grid gap-5 sm:grid-cols-2">
							{byYear.get(year)!.map((post) => (
								<li
									data-animate
									class="group relative rounded-xl border border-zinc-800 bg-zinc-900/40 overflow-hidden hover:border-accent/40 hover:bg-zinc-900/70 transition-colors"
								>
									<a href={`/projects/${post.id}/`} class="block h-full">
										{post.data.image && (
											<div class="aspect-video overflow-hidden bg-zinc-900">
												<Img
													src={post.data.image}
													alt={post.data.title}
													width={640}
													class="!my-0 !border-0 !rounded-none w-full h-full object-cover group-hover:scale-[1.03] transition-transform duration-500"
												/>
											</div>
										)}
										<div class="p-4">
											<div class="flex items-center gap-2">
												<p class="text-xs text-zinc-500">
													<FormattedDate date={post.data.date} />
												</p>
												{post.data.featured && (
													<span class="text-[10px] uppercase tracking-wider text-accent border border-accent/30 rounded px-1.5 py-0.5">
														Featured
													</span>
												)}
											</div>
											<h3 class="font-display text-lg text-zinc-100 mt-1 group-hover:text-white">
												{post.data.title}
											</h3>
											<p class="text-sm text-zinc-400 mt-1 line-clamp-2">{post.data.description}</p>
										</div>
									</a>
								</li>
							))}
						</ul>
					</section>
				))
			}
		</main>
		<Footer />
	</body>
</html>
