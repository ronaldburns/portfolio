---
import { SITE_TITLE, SOCIALS } from '../consts';
const year = new Date().getFullYear();
---

<footer class="border-t border-zinc-800/80 mt-20">
	<div class="max-w-3xl mx-auto px-4 py-10 flex flex-col sm:flex-row items-center justify-between gap-4 text-sm text-zinc-500">
		<span>&copy; {year} {SITE_TITLE}</span>
		<div class="flex gap-4">
			{
				SOCIALS.map((s) => (
					<a href={s.href} target="_blank" rel="noopener" class="hover:text-zinc-200">
						{s.label}
					</a>
				))
			}
		</div>
	</div>
</footer>

<script>
	// Subtle scroll-reveal for [data-animate] elements.
	function initReveal() {
		const items = document.querySelectorAll('[data-animate]:not(.revealed)');
		if (!items.length) return;
		if (!('IntersectionObserver' in window)) {
			items.forEach((el) => el.classList.add('revealed'));
			return;
		}
		const obs = new IntersectionObserver(
			(entries, o) => {
				entries.forEach((entry) => {
					if (entry.isIntersecting) {
						entry.target.classList.add('revealed');
						o.unobserve(entry.target);
					}
				});
			},
			{ rootMargin: '0px 0px -10% 0px' },
		);
		items.forEach((el) => obs.observe(el));
	}
	document.addEventListener('astro:page-load', initReveal);
</script>
