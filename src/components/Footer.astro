---
import { SITE_TITLE, SOCIALS } from '../consts';
const year = new Date().getFullYear();
---

<footer class="border-t border-zinc-800/80 mt-20">
	<div class="max-w-3xl mx-auto px-4 py-10 flex flex-col sm:flex-row items-center justify-between gap-4 text-sm text-zinc-500">
		<span>&copy; {year} {SITE_TITLE}</span>
		<div class="flex gap-4">
			{
				SOCIALS.map((s) => (
					<a href={s.href} target="_blank" rel="noopener" class="hover:text-zinc-200">
						{s.label}
					</a>
				))
			}
		</div>
	</div>
</footer>
