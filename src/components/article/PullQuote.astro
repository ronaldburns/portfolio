---
// A line lifted out of the text and set large. Write it without quote marks.
import '../../styles/article.css';

interface Props {
	cite?: string;
}

const { cite } = Astro.props;
---

<figure class="ar-block ar-pullquote">
	<blockquote class="font-display"><slot /></blockquote>
	{cite && <figcaption class="ar-pullquote__cite">{cite}</figcaption>}
</figure>
