---
// A visible notice for fan work, licensing and similar small print.
import '../../styles/article.css';

interface Props {
	title?: string;
}

const { title } = Astro.props;
---

<div class="ar-block ar-disclaimer" role="note">
	<svg
		class="ar-disclaimer__icon"
		viewBox="0 0 24 24"
		fill="none"
		stroke="currentColor"
		stroke-width="2"
		stroke-linecap="round"
		stroke-linejoin="round"
		aria-hidden="true"
	>
		<circle cx="12" cy="12" r="9"></circle>
		<path d="M14.8 9.2a4 4 0 1 0 0 5.6"></path>
	</svg>
	<div>
		{title && <p class="ar-disclaimer__title">{title}</p>}
		<div class="ar-disclaimer__body"><slot /></div>
	</div>
</div>
