---
// Before/after slider for two shots from the same camera. A native range input sits over the
// stacked images, so arrow keys, Page Up/Down, Home/End and screen readers work as on any slider.
import '../../styles/article.css';
import { imageUrl } from '../../lib/images';

interface Props {
	before: string;
	after: string;
	beforeLabel?: string;
	afterLabel?: string;
	alt: string;
	width: number;
	height: number;
	caption?: string;
	/** Where the divider starts, in percent from the left. */
	start?: number;
}

const {
	before,
	after,
	beforeLabel = 'Before',
	afterLabel = 'After',
	alt,
	width,
	height,
	caption,
	start = 50,
} = Astro.props;
const hasCaption = Boolean(caption) || Astro.slots.has('caption');
const pos = Math.round(Math.min(100, Math.max(0, start)));
---

<figure class="ar-block ar-figure ar-compare" data-ar-compare style={`--ar-pos: ${pos}%`}>
	<div class="ar-frame ar-compare__frame">
		<img
			class="ar-img"
			src={imageUrl(before)}
			alt={`${alt} (${beforeLabel})`}
			width={width}
			height={height}
			loading="lazy"
			decoding="async"
		/>
		<img
			class="ar-img ar-compare__after"
			src={imageUrl(after)}
			alt={`${alt} (${afterLabel})`}
			width={width}
			height={height}
			loading="lazy"
			decoding="async"
		/>
		<span class="ar-compare__label" data-side="before" aria-hidden="true">{beforeLabel}</span>
		<span class="ar-compare__label" data-side="after" aria-hidden="true">{afterLabel}</span>
		<input
			class="ar-compare__range"
			type="range"
			min="0"
			max="100"
			step="1"
			value={pos}
			aria-label={`Compare ${beforeLabel} with ${afterLabel}`}
			aria-valuetext={`${beforeLabel} ${pos}%, ${afterLabel} ${100 - pos}%`}
			data-before={beforeLabel}
			data-after={afterLabel}
		/>
		<span class="ar-compare__handle" aria-hidden="true">
			<span class="ar-compare__knob">
				<svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
					<path d="m9 7-5 5 5 5M15 7l5 5-5 5" />
				</svg>
			</span>
		</span>
	</div>
	{hasCaption && <figcaption class="ar-caption">{caption ?? <slot name="caption" />}</figcaption>}
</figure>

<script>
	function setup(figure: HTMLElement) {
		const frame = figure.querySelector<HTMLElement>('.ar-compare__frame');
		const range = figure.querySelector<HTMLInputElement>('.ar-compare__range');
		if (!frame || !range) return;
		figure.dataset.ready = '';
		const beforeLabel = range.dataset.before ?? 'Before';
		const afterLabel = range.dataset.after ?? 'After';

		const show = (pos: number) => {
			figure.style.setProperty('--ar-pos', `${pos}%`);
			const left = Math.round(pos);
			range.setAttribute('aria-valuetext', `${beforeLabel} ${left}%, ${afterLabel} ${100 - left}%`);
		};
		// The divider follows the pointer exactly. The input only keeps a rounded copy for keyboard use.
		const follow = (event: PointerEvent) => {
			const box = frame.getBoundingClientRect();
			const pos = Math.min(100, Math.max(0, ((event.clientX - box.left) / box.width) * 100));
			range.value = String(Math.round(pos));
			show(pos);
		};

		let pointer: number | null = null;
		let dragging = false;
		let startX = 0;
		frame.addEventListener('pointerdown', (event) => {
			if (!event.isPrimary || event.button !== 0) return;
			pointer = event.pointerId;
			startX = event.clientX;
			frame.setPointerCapture(event.pointerId);
			// A mouse drags at once. Touch waits to see a sideways move, so a vertical swipe still scrolls.
			dragging = event.pointerType === 'mouse';
			if (dragging) {
				range.focus({ preventScroll: true });
				follow(event);
			}
		});
		frame.addEventListener('pointermove', (event) => {
			if (event.pointerId !== pointer) return;
			if (!dragging && Math.abs(event.clientX - startX) > 6) dragging = true;
			if (dragging) follow(event);
		});
		const end = (event: PointerEvent) => {
			if (event.pointerId !== pointer) return;
			// A tap without a drag moves the divider to where the finger landed.
			if (event.type === 'pointerup' && !dragging) follow(event);
			pointer = null;
			dragging = false;
		};
		frame.addEventListener('pointerup', end);
		frame.addEventListener('pointercancel', end);
		range.addEventListener('input', () => show(Number(range.value)));
	}

	function init() {
		document.querySelectorAll<HTMLElement>('[data-ar-compare]:not([data-ready])').forEach(setup);
	}

	init();
	document.addEventListener('astro:page-load', init);
</script>
